<UserControl x:Class="MusicLibraryManager.Presentation.TrackListItem"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:MusicLibraryManager.ViewModels"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
mc:Ignorable="d"
HorizontalAlignment="Stretch"
HorizontalContentAlignment="Stretch">

<Border x:Name="ItemBorder"
    Background="{ThemeResource SurfaceBrush}"
    Padding="12,8"
    CornerRadius="4"
    PointerEntered="ItemBorder_PointerEntered"
    PointerExited="ItemBorder_PointerExited"
    PointerPressed="ItemBorder_PointerPressed"
    PointerReleased="ItemBorder_PointerReleased">
    <Border.ContextFlyout>
        <MenuFlyout>
            <MenuFlyoutItem Text="Copy File Name" Command="{Binding CopyFileNameCommand}" />
            <MenuFlyoutItem Text="Copy Artist" Command="{Binding CopyArtistCommand}" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Copy (File Name + Artist)" Command="{Binding CopyFileNameAndArtistCommand}" />
            <MenuFlyoutItem Text="Copy (Title + Artist)" Command="{Binding CopyTitleAndArtistCommand}" />
        </MenuFlyout>
    </Border.ContextFlyout>
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding Parent.FileNameColumnWidth}" MinWidth="80" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="80" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding Parent.ArtistColumnWidth}" MinWidth="80" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding Parent.YearColumnWidth}" MinWidth="50" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding DisplayIndex}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Opacity="0.7"
                   VerticalAlignment="Center" />

        <!-- Album Art Thumbnail -->
        <Border Grid.Column="1"
                Width="36"
                Height="36"
                CornerRadius="4"
                Margin="0,0,12,0"
                Background="{ThemeResource SurfaceVariantBrush}">
            <Grid>
                <FontIcon Glyph="&#xE8B9;"
                          FontSize="16"
                          Opacity="0.3"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <Image Source="{Binding AlbumCover}"
                       Stretch="UniformToFill" />
            </Grid>
        </Border>

        <!-- Filename -->
        <TextBlock Grid.Column="2"
                   Text="{Binding FullFileName}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Opacity="0.7"
                   TextTrimming="Clip"
                   TextWrapping="NoWrap"
                   MaxLines="1" />

        <!-- Splitter placeholder -->
        <Border Grid.Column="3" Width="16" />

        <!-- Song Name -->
        <TextBlock Grid.Column="4"
                   Text="{Binding SongName}"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextTrimming="Clip"
                   TextWrapping="NoWrap"
                   MaxLines="1" />

        <!-- Splitter placeholder -->
        <Border Grid.Column="5" Width="16" />

        <!-- Artist -->
        <TextBlock Grid.Column="6"
                   Text="{Binding Artist}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Opacity="0.7"
                   TextTrimming="Clip"
                   TextWrapping="NoWrap"
                   MaxLines="1" />

        <!-- Splitter placeholder -->
        <Border Grid.Column="7" Width="16" />

        <!-- Year -->
        <TextBlock Grid.Column="8"
                   Text="{Binding Year}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Opacity="0.5" />
    </Grid>
</Border>
</UserControl>
