<UserControl x:Class="MusicLibraryManager.Presentation.TrackListItem"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:vm="using:MusicLibraryManager.ViewModels"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     mc:Ignorable="d"
     HorizontalAlignment="Stretch"
     HorizontalContentAlignment="Stretch"
     d:DataContext="{d:DesignInstance Type=vm:TrackListItemViewModel}">

<Border x:Name="ItemBorder"
        Background="{ThemeResource SurfaceBrush}"
        Padding="12,8"
        CornerRadius="4"
        PointerEntered="ItemBorder_PointerEntered"
        PointerExited="ItemBorder_PointerExited"
        PointerPressed="ItemBorder_PointerPressed"
        PointerReleased="ItemBorder_PointerReleased">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Song Name -->
            <TextBlock Grid.Column="0"
                       Text="{Binding SongName}"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       MaxWidth="200" />

            <!-- Artist - Album -->
            <TextBlock Grid.Column="1"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       Margin="12,0,0,0">
                <Run Text="{Binding Artist}" />
                <Run Text=" • " />
                <Run Text="{Binding AlbumTitle}" />
            </TextBlock>

            <!-- Year -->
            <TextBlock Grid.Column="2"
                       Text="{Binding Year}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.5"
                       Margin="12,0,0,0" />
        </Grid>
    </Border>
</UserControl>
