<UserControl x:Class="MusicLibraryManager.Presentation.TrackListItem"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:MusicLibraryManager.ViewModels"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
mc:Ignorable="d"
HorizontalAlignment="Stretch"
HorizontalContentAlignment="Stretch">

<Border x:Name="ItemBorder"
    Background="{ThemeResource SurfaceBrush}"
    Padding="12,8"
    CornerRadius="4"
    PointerEntered="ItemBorder_PointerEntered"
    PointerExited="ItemBorder_PointerExited"
    PointerPressed="ItemBorder_PointerPressed"
    PointerReleased="ItemBorder_PointerReleased">
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="80" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding Parent.ArtistColumnWidth}" MinWidth="80" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding Parent.YearColumnWidth}" MinWidth="50" />
        </Grid.ColumnDefinitions>

        <!-- Song Name -->
        <TextBlock Grid.Column="0"
                   Text="{Binding SongName}"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextTrimming="Clip"
                   TextWrapping="NoWrap"
                   MaxLines="1" />

        <!-- Splitter placeholder -->
        <Border Grid.Column="1" Width="16" />

        <!-- Artist -->
        <TextBlock Grid.Column="2"
                   Text="{Binding Artist}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Opacity="0.7"
                   TextTrimming="Clip"
                   TextWrapping="NoWrap"
                   MaxLines="1" />

        <!-- Splitter placeholder -->
        <Border Grid.Column="3" Width="16" />

        <!-- Year -->
        <TextBlock Grid.Column="4"
                   Text="{Binding Year}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Opacity="0.5" />
    </Grid>
</Border>
</UserControl>
