<UserControl x:Class="MusicLibraryManager.Presentation.SoundCloud.SoundCloudSignInPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicLibraryManager.ViewModels.SoundCloud"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SoundCloudSignInViewModel}">

    <Grid Background="{ThemeResource BackgroundBrush}"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Padding="48">
        <StackPanel Spacing="24"
                    MaxWidth="400">

            <!-- SoundCloud Logo/Title -->
            <StackPanel Spacing="8"
                        HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8D6;"
                          FontSize="64"
                          Foreground="{ThemeResource PrimaryBrush}" />
                <TextBlock Text="Connect to SoundCloud"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Sign in to search and browse tracks"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Opacity="0.7"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error Message -->
            <Border Background="{ThemeResource ErrorContainerBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Visibility="{Binding HasError}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{ThemeResource OnErrorContainerBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Sign In Button (Initial State) -->
            <StackPanel Visibility="{Binding IsSigningIn, Converter={StaticResource TrueToCollapsedConverter}}">
                <Button Command="{Binding SignInCommand}"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource FilledButtonStyle}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8A7;"
                                  FontSize="16" />
                        <TextBlock Text="Sign in with SoundCloud" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Waiting for Authorization State -->
            <StackPanel Spacing="16"
                        Visibility="{Binding IsSigningIn}"
                        HorizontalAlignment="Center">
                <ProgressRing IsActive="{Binding IsSigningIn}"
                              Width="32"
                              Height="32" />

                <TextBlock Text="Waiting for authorization..."
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Opacity="0.8" />

                <TextBlock Text="Complete sign-in in your browser, then return here."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Opacity="0.6"
                           TextWrapping="Wrap" />

                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource OutlinedButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0" />
            </StackPanel>

            <!-- Info Text -->
            <TextBlock Text="Your credentials are stored securely on this device."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.5"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
