<UserControl x:Class="MusicLibraryManager.Presentation.SoundCloud.SoundCloudSearchListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicLibraryManager.ViewModels.SoundCloud"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SoundCloudSearchListViewModel}">

    <Border Background="{ThemeResource SurfaceVariantBrush}"
            CornerRadius="8"
            Margin="4,8,8,8"
            Translation="0,0,8">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search Box -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Search SoundCloud..."
                         Margin="0,0,8,0" />
                <Button Grid.Column="1"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource FilledButtonStyle}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE721;"
                                  FontSize="14" />
                        <TextBlock Text="Search" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Search Results -->
            <Grid Grid.Row="1">
                <!-- Loading Indicator -->
                <ProgressRing IsActive="{Binding IsSearching}"
                              Visibility="{Binding IsSearching}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                <!-- Results List -->
                <ListView ItemsSource="{Binding SearchResults}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SoundCloudSearchItemViewModel">
                            <Grid Padding="8"
                                  Background="Transparent"
                                  PointerPressed="SearchItem_PointerPressed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Album Art Thumbnail -->
                                <Border Grid.Column="0"
                                        Width="48"
                                        Height="48"
                                        CornerRadius="4"
                                        Margin="0,0,12,0"
                                        Background="{ThemeResource SurfaceBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8B9;"
                                                  FontSize="20"
                                                  Opacity="0.3"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        <Image Source="{x:Bind AlbumCover, Mode=OneWay}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <!-- Track Info -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Opacity="0.7"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>

                                <!-- Duration -->
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Duration, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Opacity="0.7"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State (shown when not searching and no results) -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Visibility>
                        <Binding Path="IsSearching">
                            <Binding.TargetNullValue>Visible</Binding.TargetNullValue>
                        </Binding>
                    </StackPanel.Visibility>
                    <FontIcon Glyph="&#xE721;"
                              FontSize="48"
                              Opacity="0.3"
                              Margin="0,0,0,12" />
                    <TextBlock Text="Search for tracks on SoundCloud"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Opacity="0.5"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
