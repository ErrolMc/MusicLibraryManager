<UserControl x:Class="MusicLibraryManager.Presentation.SoundCloud.SoundCloudTrackInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicLibraryManager.ViewModels.SoundCloud"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SoundCloudTrackInfoPanelViewModel}">

    <Border Background="{ThemeResource SurfaceVariantBrush}"
            CornerRadius="8"
            Margin="8,8,4,8"
            Translation="0,0,8">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Track Info"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,8" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6"
                            HorizontalAlignment="Stretch"
                            Padding="0,0,20,0"
                            Visibility="{Binding HasTrackLoaded}">

                    <!-- Album Art at top for SoundCloud -->
                    <StackPanel Spacing="2"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center">
                        <Border Background="{ThemeResource SurfaceBrush}"
                                CornerRadius="4"
                                Width="180"
                                Height="180"
                                BorderBrush="{ThemeResource OutlineBrush}"
                                BorderThickness="1">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Copy"
                                                    Command="{Binding CopyAlbumCoverCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid>
                                <FontIcon Glyph="&#xE8B9;"
                                          FontSize="48"
                                          Opacity="0.3"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                <Image Source="{Binding AlbumCover}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Track details with copy context menu -->
                    <StackPanel Spacing="6">
                        <StackPanel.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Copy Title"
                                                Command="{Binding CopyFieldCommand}"
                                                CommandParameter="Title">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy Artist"
                                                Command="{Binding CopyFieldCommand}"
                                                CommandParameter="Artist">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy Album"
                                                Command="{Binding CopyFieldCommand}"
                                                CommandParameter="Album">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy Genre"
                                                Command="{Binding CopyFieldCommand}"
                                                CommandParameter="Genre">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy Year"
                                                Command="{Binding CopyFieldCommand}"
                                                CommandParameter="Year">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy Duration"
                                                Command="{Binding CopyFieldCommand}"
                                                CommandParameter="Duration">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy Description"
                                                Command="{Binding CopyFieldCommand}"
                                                CommandParameter="Description">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </StackPanel.ContextFlyout>

                        <!-- Title -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Title"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7" />
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Artist -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Artist"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7" />
                            <TextBlock Text="{Binding Artist}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Album -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Album"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7" />
                            <TextBlock Text="{Binding Album}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Duration -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Duration"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7" />
                            <TextBlock Text="{Binding Duration}"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>

                        <!-- Genre -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Genre"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7" />
                            <TextBlock Text="{Binding Genre}"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>

                        <!-- Year -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Year"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7" />
                            <TextBlock Text="{Binding Year}"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>

                        <!-- Comment -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Description"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7" />
                            <TextBlock Text="{Binding Comment}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Playback Controls -->
            <StackPanel Grid.Row="2"
                        Spacing="4"
                        Margin="0,8,0,0"
                        Visibility="{Binding HasTrackLoaded}">
                <TextBlock Text="Playback"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.7" />

                <!-- Transport buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="4">
                    <Button Command="{Binding PlayPauseCommand}"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Padding="0">
                        <Grid>
                            <!-- Play icon (visible when not playing) -->
                            <FontIcon Glyph="&#xE768;"
                                      FontSize="18"
                                      Visibility="{Binding IsPlaying, Converter={StaticResource TrueToCollapsedConverter}}" />
                            <!-- Pause icon (visible when playing) -->
                            <FontIcon Glyph="&#xE769;"
                                      FontSize="18"
                                      Visibility="{Binding IsPlaying}" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding StopPlaybackCommand}"
                            Width="36" Height="36"
                            CornerRadius="18"
                            Padding="0">
                        <FontIcon Glyph="&#xE71A;"
                                  FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- Loading indicator -->
                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsLoadingStream}"
                             Margin="0,2" />

                <!-- Seek slider with time labels -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding PositionText}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Slider Grid.Column="1"
                            x:Name="SeekSlider"
                            Minimum="0"
                            Maximum="{Binding PlaybackDuration}"
                            Value="{Binding PlaybackPosition, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            PointerPressed="SeekSlider_PointerPressed"
                            PointerReleased="SeekSlider_PointerReleased"
                            PointerCaptureLost="SeekSlider_PointerCaptureLost" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DurationText}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                </Grid>

                <!-- Volume -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE767;"
                              FontSize="14"
                              Opacity="0.7"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0" />
                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding Volume, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
