<Window x:Class="MusicLibraryManager.Presentation.SoundCloud.SoundCloudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scviews="using:MusicLibraryManager.Presentation.SoundCloud"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SoundCloud">

    <Grid x:Name="RootGrid" Background="{ThemeResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Sign Out button (when authenticated) -->
        <Grid Grid.Row="0"
              Visibility="{Binding IsAuthenticated}"
              Padding="16,8">
            <Button Command="{Binding SignOutCommand}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource OutlinedButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                    <TextBlock Text="Sign Out" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Loading State -->
        <ProgressRing Grid.Row="1"
                      IsActive="{Binding IsLoading}"
                      Visibility="{Binding IsLoading}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="48"
                      Height="48" />

        <!-- Sign In Panel (when not authenticated and not loading) -->
        <scviews:SoundCloudSignInPanel Grid.Row="1"
                                        DataContext="{Binding SignInViewModel}"
                                        Visibility="{Binding DataContext.IsAuthenticated, ElementName=RootGrid, Converter={StaticResource TrueToCollapsedConverter}}" />

        <!-- Main Content (Split Panel) - when authenticated -->
        <scviews:SoundCloudSplitPanelPage Grid.Row="1"
                                           DataContext="{Binding SplitPanelViewModel}"
                                           Visibility="{Binding DataContext.IsAuthenticated, ElementName=RootGrid}" />
    </Grid>
</Window>
