<Window x:Class="MusicLibraryManager.Presentation.SoundCloud.SoundCloudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scviews="using:MusicLibraryManager.Presentation.SoundCloud"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SoundCloud">

    <Grid x:Name="RootGrid" Background="{ThemeResource BackgroundBrush}">
        <!-- Loading State -->
        <ProgressRing
                      IsActive="{Binding IsLoading}"
                      Visibility="{Binding IsLoading}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="48"
                      Height="48" />

        <!-- Sign In Panel (when not authenticated and not loading) -->
        <scviews:SoundCloudSignInPanel DataContext="{Binding SignInViewModel}"
                                        Visibility="{Binding DataContext.IsAuthenticated, ElementName=RootGrid, Converter={StaticResource TrueToCollapsedConverter}}" />

        <!-- Main Content (Split Panel) - when authenticated -->
        <scviews:SoundCloudSplitPanelPage DataContext="{Binding SplitPanelViewModel}"
                                           Visibility="{Binding DataContext.IsAuthenticated, ElementName=RootGrid}" />

        <Border Background="{ThemeResource SurfaceVariantBrush}"
                Opacity="0.9"
                Visibility="{Binding SplitPanelViewModel.SoundCloudTrackInfoPanelViewModel.IsPickPlaceholderMode}"
                IsHitTestVisible="{Binding SplitPanelViewModel.SoundCloudTrackInfoPanelViewModel.IsPickPlaceholderMode}">
            <Grid>
                <Border Background="{ThemeResource SurfaceBrush}"
                        Padding="20"
                        CornerRadius="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Translation="0,0,16">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <TextBlock Text="{Binding SplitPanelViewModel.SoundCloudTrackInfoPanelViewModel.PlaceholderOverlayMessage}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               MaxWidth="320" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
