<Page x:Class="MusicLibraryManager.Presentation.SyncPlaylistPanelPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:MusicLibraryManager.ViewModels"
xmlns:views="using:MusicLibraryManager.Presentation"
xmlns:scviews="using:MusicLibraryManager.Presentation.SoundCloud"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:utu="using:Uno.Toolkit.UI"
Background="{ThemeResource BackgroundBrush}"
mc:Ignorable="d"
d:DataContext="{d:DesignInstance Type=vm:SyncPlaylistPanelViewModel}">

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:MenuBar Grid.Row="0"
                       DataContext="{Binding MenuBarViewModel}"
                       ShowOpenButton="True"
                       ShowSyncPlaylistButton="False"
                       ShowMainPanelButton="True" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="12,8,12,0">
            <Button x:Name="SelectSoundCloudPlaylistButton"
                    Content="{Binding SelectedPlaylistTitle}"
                    IsEnabled="{Binding IsSelectSoundCloudPlaylistEnabled}"
                    MaxWidth="320"
                    Click="SelectSoundCloudPlaylistButton_Click"
                    Style="{StaticResource FilledTonalButtonStyle}" />

            <Button Content="sync local playlist to soundcloud"
                    Command="{Binding SyncLocalPlaylistToSoundCloudCommand}"
                    IsEnabled="{Binding IsSyncButtonEnabled}"
                    Style="{StaticResource FilledButtonStyle}" />

            <Button Content="show soundcloud playlist order"
                    Command="{Binding ShowPlaylistOrderCommand}"
                    IsEnabled="{Binding IsShowPlaylistOrderEnabled}"
                    Style="{StaticResource FilledTonalButtonStyle}" />

            <Button Content="run ai matching"
                    Command="{Binding RunAiMatchingCommand}"
                    IsEnabled="{Binding IsAiMatchEnabled}"
                    Style="{StaticResource FilledButtonStyle}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="LeftSyncGrid" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LocalInfoColumn" Width="*" MinWidth="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="LocalListColumn" Width="*" MinWidth="100" />
                </Grid.ColumnDefinitions>

                <views:TrackInfoPanel Grid.Column="0"
                                      DataContext="{Binding TrackInfoPanelViewModel}"
                                      IsReadOnly="True" />

                <Border Grid.Column="1"
                        x:Name="LocalSplitter"
                        Width="8"
                        Background="Transparent"
                        Margin="0,16"
                        CornerRadius="4"
                        PointerEntered="LocalSplitter_PointerEntered"
                        PointerExited="LocalSplitter_PointerExited"
                        PointerPressed="LocalSplitter_PointerPressed"
                        PointerMoved="LocalSplitter_PointerMoved"
                        PointerReleased="LocalSplitter_PointerReleased"
                        PointerCaptureLost="LocalSplitter_PointerCaptureLost">
                    <Border Background="{ThemeResource OnSurfaceVariantBrush}"
                            Opacity="0.3"
                            Width="4"
                            CornerRadius="2"
                            HorizontalAlignment="Center" />
                </Border>

                <views:TrackListPanel x:Name="LocalTrackListPanel"
                                      Grid.Column="2"
                                      DataContext="{Binding TrackListPanelViewModel}"
                                      Loaded="LocalTrackListPanel_Loaded" />
            </Grid>

            <ScrollBar x:Name="LinkedScrollBar"
                       Grid.Column="1"
                       Width="16"
                       Margin="2,16"
                       Orientation="Vertical"
                       SmallChange="16"
                       ValueChanged="LinkedScrollBar_ValueChanged"
                       Visibility="Visible" />

            <Grid x:Name="RightSyncGrid" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SoundCloudListColumn" Width="*" MinWidth="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="SoundCloudInfoColumn" Width="*" MinWidth="100" />
                </Grid.ColumnDefinitions>

                <scviews:SoundCloudTrackListPanel x:Name="SoundCloudTrackListPanel"
                                                  Grid.Column="0"
                                                  Margin="0,0,-4,0"
                                                  DataContext="{Binding SyncSoundCloudTrackListViewModel}"
                                                  HeaderTitle="{Binding SoundCloudPlaylistTitle}"
                                                  FooterTitle="{Binding SoundCloudPlaylistTitle}"
                                                  Loaded="LocalTrackListPanel_Loaded" />

                <Border Grid.Column="1"
                        x:Name="SoundCloudSplitter"
                        Width="8"
                        Background="Transparent"
                        Margin="0,16"
                        CornerRadius="4"
                        PointerEntered="SoundCloudSplitter_PointerEntered"
                        PointerExited="SoundCloudSplitter_PointerExited"
                        PointerPressed="SoundCloudSplitter_PointerPressed"
                        PointerMoved="SoundCloudSplitter_PointerMoved"
                        PointerReleased="SoundCloudSplitter_PointerReleased"
                        PointerCaptureLost="SoundCloudSplitter_PointerCaptureLost">
                    <Border Background="{ThemeResource OnSurfaceVariantBrush}"
                            Opacity="0.3"
                            Width="4"
                            CornerRadius="2"
                            HorizontalAlignment="Center" />
                </Border>

                <scviews:SoundCloudTrackInfoPanel Grid.Column="2"
                                                  Margin="-4,0,0,0"
                                                  DataContext="{Binding SoundCloudTrackInfoPanelViewModel}" />
            </Grid>

        </Grid>

        <Border Grid.RowSpan="3"
                Background="{ThemeResource SurfaceVariantBrush}"
                Opacity="0.85"
                Visibility="{Binding IsBusyOverlayVisible}"
                IsHitTestVisible="{Binding IsBusyOverlayVisible}"
                Canvas.ZIndex="100">
            <Grid>
                <Border Background="{ThemeResource SurfaceBrush}"
                        Padding="24"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Translation="0,0,16">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>

                    <StackPanel Spacing="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ProgressRing IsActive="True"
                                      Width="56"
                                      Height="56"
                                      HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding BusyOverlayMessage}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="WrapWholeWords"
                                   MaxWidth="320" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
