<Page x:Class="MusicLibraryManager.Presentation.HomePanelPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:MusicLibraryManager.ViewModels"
xmlns:views="using:MusicLibraryManager.Presentation"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:utu="using:Uno.Toolkit.UI"
Background="{ThemeResource BackgroundBrush}"
mc:Ignorable="d"
d:DataContext="{d:DesignInstance Type=vm:HomePanelViewModel}">

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:MenuBar Grid.Row="0"
                       DataContext="{Binding MenuBarViewModel}"
                       ShowOpenButton="False"
                       ShowSyncPlaylistButton="True"
                       ShowMainPanelButton="True" />

        <Grid Grid.Row="1" Padding="24">
            <Border Background="{ThemeResource SurfaceVariantBrush}"
                    CornerRadius="8"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="560"
                    Translation="0,0,8">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Spacing="8">
                    <TextBlock Text="Welcome"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Use Main Panel to manage local tracks, or Sync Playlist to compare local tracks with SoundCloud."
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
