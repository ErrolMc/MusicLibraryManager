<UserControl x:Class="MusicLibraryManager.Presentation.TrackListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicLibraryManager.ViewModels"
             xmlns:views="using:MusicLibraryManager.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TrackListPanelViewModel}">

    <Border Background="{ThemeResource SurfaceVariantBrush}"
            CornerRadius="8"
            Margin="4,8,8,8"
            Translation="0,0,8">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Title}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,12" />

            <!-- Column Headers -->
            <Border Grid.Row="1"
                    Background="{ThemeResource SurfaceBrush}"
                    Padding="12,8"
                    CornerRadius="4"
                    Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding FileNameColumnWidth, Mode=TwoWay}" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{Binding ArtistColumnWidth, Mode=TwoWay}" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{Binding YearColumnWidth, Mode=TwoWay}" MinWidth="50" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Filename"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Opacity="0.7" />

                    <Border Grid.Column="1"
                            x:Name="FileNameSplitter"
                            Width="8"
                            Background="Transparent"
                            Margin="4,0"
                            ManipulationMode="TranslateX"
                            ManipulationStarted="Splitter_ManipulationStarted"
                            ManipulationDelta="FileNameSplitter_ManipulationDelta"
                            ManipulationCompleted="Splitter_ManipulationCompleted"
                            PointerEntered="Splitter_PointerEntered"
                            PointerExited="Splitter_PointerExited">
                        <Rectangle Width="2"
                                   Fill="{ThemeResource OutlineBrush}"
                                   Opacity="0.3"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="2"
                               Text="Title"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Opacity="0.7" />

                    <Border Grid.Column="3"
                            x:Name="ArtistSplitter"
                            Width="8"
                            Background="Transparent"
                            Margin="4,0"
                            ManipulationMode="TranslateX"
                            ManipulationStarted="Splitter_ManipulationStarted"
                            ManipulationDelta="ArtistSplitter_ManipulationDelta"
                            ManipulationCompleted="Splitter_ManipulationCompleted"
                            PointerEntered="Splitter_PointerEntered"
                            PointerExited="Splitter_PointerExited">
                        <Rectangle Width="2"
                                   Fill="{ThemeResource OutlineBrush}"
                                   Opacity="0.3"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="4"
                               Text="Artist"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Opacity="0.7" />

                    <Border Grid.Column="5"
                            x:Name="YearSplitter"
                            Width="8"
                            Background="Transparent"
                            Margin="4,0"
                            ManipulationMode="TranslateX"
                            ManipulationStarted="Splitter_ManipulationStarted"
                            ManipulationDelta="YearSplitter_ManipulationDelta"
                            ManipulationCompleted="Splitter_ManipulationCompleted"
                            PointerEntered="Splitter_PointerEntered"
                            PointerExited="Splitter_PointerExited">
                        <Rectangle Width="2"
                                   Fill="{ThemeResource OutlineBrush}"
                                   Opacity="0.3"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="6"
                               Text="Year"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Opacity="0.7" />
                </Grid>
            </Border>

            <!-- Track List -->
            <ListView Grid.Row="2"
                      ItemsSource="{Binding Tracks}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="Stretch"
                                                      Margin="0,2" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackListItemViewModel">
                        <views:TrackListItem DataContext="{Binding}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Folder Path -->
            <TextBox Grid.Row="3"
                     Text="{Binding FolderPath}"
                     IsReadOnly="True"
                     Margin="0,12,0,0"
                     PlaceholderText="No folder selected" />
        </Grid>
    </Border>
</UserControl>
