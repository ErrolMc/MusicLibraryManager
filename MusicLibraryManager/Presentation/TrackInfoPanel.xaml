<UserControl x:Class="MusicLibraryManager.Presentation.TrackInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicLibraryManager.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TrackInfoPanelViewModel}">

    <Border Background="{ThemeResource SurfaceVariantBrush}"
            CornerRadius="8"
            Margin="8,8,4,8"
            Translation="0,0,8">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Track Info"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,8" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6"
                            HorizontalAlignment="Left">
                    
                    <!-- Title -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Title"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7" />
                        <TextBox MinWidth="200" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Title"
                        MinHeight="24"
                        Padding="0" />
                    </StackPanel>

                    <!-- Artist -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Artist"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7" />
                        <TextBox Text="{Binding Artist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Artist"
                        MinWidth="200"
                        MinHeight="24"
                        Padding="0" />
                    </StackPanel>

                    <!-- Album -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Album"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7" />
                        <TextBox Text="{Binding Album, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Album"
                        MinWidth="200"
                        MinHeight="24"
                        Padding="0" />
                    </StackPanel>

                    <!-- Album Artist -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Album Artist"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7" />
                        <TextBox Text="{Binding AlbumArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Album Artist"
                        MinWidth="200"
                        MinHeight="24"
                        Padding="0" />
                    </StackPanel>

                    <!-- Composer -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Composer"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7" />
                        <TextBox Text="{Binding Composer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Composer"
                        MinWidth="200"
                        MinHeight="24"
                        Padding="0" />
                    </StackPanel>

                    <!-- Track / Year / Genre Row -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Track"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7" />
                            <TextBox Text="{Binding Track, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="#"
                            Width="50"
                            MinHeight="24"
                            Padding="0" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Year"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7" />
                            <TextBox Text="{Binding Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Year"
                            Width="60"
                            MinHeight="24"
                            Padding="0" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Genre"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7" />
                            <TextBox Text="{Binding Genre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Genre"
                            Width="74"
                            MinHeight="24"
                            Padding="0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Comment -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Comment"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7" />
                        <TextBox Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Comment"
                        MinWidth="200"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MinHeight="24"
                        Padding="0" />
                    </StackPanel>

                    <!-- Album Photo -->
                    <StackPanel Spacing="2"
                                Margin="0,4,0,0">
                        <TextBlock Text="Album Art"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7" />
                        <Border Background="{ThemeResource SurfaceBrush}"
                                CornerRadius="4"
                                Width="120"
                                Height="120"
                                HorizontalAlignment="Left"
                                BorderBrush="{ThemeResource OutlineBrush}"
                                BorderThickness="1">
                            <Grid>
                                <FontIcon Glyph="&#xE8B9;"
                                          FontSize="32"
                                          Opacity="0.3"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                <Image Source="{Binding AlbumCover}"
                                Stretch="UniformToFill"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
