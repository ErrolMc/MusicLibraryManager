<UserControl x:Class="MusicLibraryManager.Presentation.TrackInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicLibraryManager.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TrackInfoPanelViewModel}">

    <Border Background="{ThemeResource SurfaceVariantBrush}"
            CornerRadius="8"
            Margin="8,8,4,8"
            Translation="0,0,8">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Track Info"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   Margin="0,0,0,8" />

        <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="6"
                        HorizontalAlignment="Stretch"
                        Padding="0,0,20,0">

                <!-- Filename -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Filename"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding FileNameWithoutExtension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Filename"
                                 MinHeight="24"
                                 Padding="0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FileExtension}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Opacity="0.5"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0" />
                    </Grid>
                </StackPanel>
                    
                <!-- Title -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Title"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7" />
                    <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Title"
                             HorizontalAlignment="Stretch"
                             MinHeight="24"
                             Padding="0" />
                </StackPanel>

                <!-- Artist -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Artist"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7" />
                    <TextBox Text="{Binding Artist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Artist"
                             HorizontalAlignment="Stretch"
                             MinHeight="24"
                             Padding="0" />
                </StackPanel>

                <!-- Album -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Album"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7" />
                    <TextBox Text="{Binding Album, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Album"
                             HorizontalAlignment="Stretch"
                             MinHeight="24"
                             Padding="0" />
                </StackPanel>

                <!-- Album Artist -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Album Artist"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7" />
                    <TextBox Text="{Binding AlbumArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Album Artist"
                             HorizontalAlignment="Stretch"
                             MinHeight="24"
                             Padding="0" />
                </StackPanel>

                <!-- Composer -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Composer"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7" />
                    <TextBox Text="{Binding Composer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Composer"
                             HorizontalAlignment="Stretch"
                             MinHeight="24"
                             Padding="0" />
                </StackPanel>

                <!-- Genre -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Genre"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7" />
                    <TextBox Text="{Binding Genre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Genre"
                             HorizontalAlignment="Stretch"
                             MinHeight="24"
                             Padding="0" />
                </StackPanel>

                <!-- Track / Year Row -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Track"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7" />
                        <TextBox Text="{Binding Track, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="#"
                                 Width="50"
                                 MinHeight="24"
                                 Padding="0" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Year"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7" />
                        <TextBox Text="{Binding Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Year"
                                 Width="60"
                                 MinHeight="24"
                                 Padding="0" />
                    </StackPanel>
                </StackPanel>

                <!-- Comment -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Comment"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7" />
                    <TextBox Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Comment"
                             HorizontalAlignment="Stretch"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="24"
                             Padding="0" />
                </StackPanel>

                    <!-- Album Photo -->
                    <StackPanel Spacing="2"
                                Margin="0,4,0,0">
                        <TextBlock Text="Album Art"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7" />
                        <Border Background="{ThemeResource SurfaceBrush}"
                                CornerRadius="0"
                                Width="120"
                                Height="120"
                                BorderBrush="{ThemeResource OutlineBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                Tapped="AlbumCover_Tapped">
                            <Border.ContextFlyout>
                                <MenuFlyout Opening="AlbumCoverContextMenu_Opening">
                                    <MenuFlyoutItem Text="Copy"
                                                    Command="{Binding CopyAlbumCoverCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Replace from Clipboard"
                                                    Command="{Binding ReplaceAlbumCoverFromClipboardCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Change"
                                                    Command="{Binding ChangeAlbumCoverCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Remove"
                                                    Command="{Binding RemoveAlbumCoverCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid>
                                <FontIcon Glyph="&#xE8B9;"
                                          FontSize="32"
                                          Opacity="0.3"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                <Image Source="{Binding AlbumCover}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                <!-- Audio Player -->
                <StackPanel Spacing="2"
                            Margin="0,4,0,0"
                            Visibility="{Binding HasTrackLoaded}">
                    <TextBlock Text="Playback"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7" />
                    <MediaPlayerElement Source="{Binding TrackMediaSource}"
                                        AutoPlay="False"
                                        AreTransportControlsEnabled="True" />
                </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>

                                            <!-- Save/Cancel Buttons -->
                                            <StackPanel Grid.Row="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Spacing="8"
                                                        Margin="0,12,15,0"
                                                        Visibility="{Binding HasChanges}">
                                                <Button Content="Cancel"
                                                        Click="CancelButton_Click"
                                                        Style="{StaticResource OutlinedButtonStyle}" />
                                                <Button Content="Save"
                                                        Click="SaveButton_Click"
                                                        Style="{StaticResource FilledButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </UserControl>
